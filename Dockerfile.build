# Dockerfile multi-stage para compilación limpia
# Uso: docker build -f Dockerfile.build -t navtunnel-builder .
#      docker run --rm -v $(pwd)/dist:/dist navtunnel-builder

# Stage 1: Builder
FROM golang:1.22-bookworm AS builder

# Instalar solo dependencias necesarias para compilar
RUN apt-get update && apt-get install -y \
    pkg-config \
    libayatana-appindicator3-dev \
    libwebkit2gtk-4.1-dev \
    && rm -rf /var/lib/apt/lists/*

# webview/webview_go pide pkg-config webkit2gtk-4.0, pero las distros modernas
# (Ubuntu 24.04, Fedora 39+) solo proveen webkit2gtk-4.1. Las APIs usadas son
# binario-compatibles; creamos un alias para que pkg-config resuelva 4.0 -> 4.1
# y el binario quede linkeado contra libwebkit2gtk-4.1.so.0 en runtime.
RUN cp /usr/lib/x86_64-linux-gnu/pkgconfig/webkit2gtk-4.1.pc \
       /usr/lib/x86_64-linux-gnu/pkgconfig/webkit2gtk-4.0.pc

WORKDIR /build

# Copiar go.mod y go.sum para cachear dependencias
COPY go.mod go.sum ./
RUN go mod download

# Copiar código fuente
COPY . .

# Compilar el binario
# -ldflags="-s -w" reduce el tamaño eliminando símbolos de debug.
RUN CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o navtunnel ./cmd/navtunnel

# Verificar que el binario se creó correctamente
RUN ls -lh navtunnel

# Stage 2: Output (opcional - para runtime minimal)
FROM scratch AS export
COPY --from=builder /build/navtunnel /navtunnel

# Por defecto, copiar el binario al volumen /output
FROM builder AS output
CMD ["sh", "-c", "cp /build/navtunnel /output/ && echo 'Binario compilado en /output/navtunnel' && ls -lh /output/navtunnel"]
